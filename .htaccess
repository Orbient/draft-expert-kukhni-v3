# Expert Кухни: сжатие и кэш для Apache-хостинга (Timeweb). Все модули в <IfModule>: если модуля нет, правило молча пропускается.
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
</IfModule>

<IfModule mod_headers.c>
  # Файлы в /_astro/ имеют хэш в имени и не меняются: кэш на год.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Страницы всегда проверяются заново (быстро: 304), чтобы правки были видны сразу.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Остальное (favicon, og.jpg, иконка) — на неделю.
  <FilesMatch "\.(ico|svg|png|jpg)$">
    Header setIfEmpty Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
